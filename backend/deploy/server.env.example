# Template of the .env that lives on the server next to docker-compose.yml (one per environment).
# Copy it to .env on the server and fill in the values. Never commit the filled-in file.
# Avoid "$" in values — docker compose would try to interpolate it.

# resort-island-dev / resort-island-prod
COMPOSE_PROJECT_NAME=resort-island-dev
# Host port of the app; use different ports when dev and prod share one machine.
APP_PORT=8081

APP_NAME="Resort Island"
# development / production
APP_ENV=development
# Generate with: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://dev-api.example.com

LOG_CHANNEL=stderr
# debug on dev, warning on prod
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=resort_island
DB_USERNAME=resort_island
# Long random string, different per environment.
DB_PASSWORD=

CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database

GAME_CONFIGS_CACHE_TTL=3600

# BACKEND_IMAGE is written by deploy.sh
